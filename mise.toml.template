# Copy to mise.toml at the module root, or generate one with:
#   mise use go@1.26
#   mise use golangci-lint@2

[tools]
go = "1.26"
golangci-lint = "2"

[tasks.run]
description = "Run the application"
run = "go run ./cmd/heroes"

[tasks.test]
description = "Run all tests"
run = "go test ./..."

[tasks.lint]
description = "Run golangci-lint"
run = "golangci-lint run"
